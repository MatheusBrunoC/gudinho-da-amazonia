[node name="Texto1" type="Label" parent="."]
layout_mode = 0
offset_left = 468.0
offset_top = 274.0
offset_right = 812.0
offset_bottom = 580.0
mouse_filter = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_outline_color = Color(0.04, 0.12, 0.08, 1)
theme_override_constants/outline_size = 3
text = "Retirou um alvo e sua bolinha parou fora do círculo? Você ganha uma única tacada extra.\n\nSem pontos, ou após a segunda tacada, a vez passa ao adversário.\n\nParou dentro do círculo? Perde a vez. No próximo turno, reposicione atrás da linha. Os pontos obtidos contam."
horizontal_alignment = 0
vertical_alignment = 0
autowrap_mode = 3

