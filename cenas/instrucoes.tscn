[node name="Texto0" type="Label" parent="."]
layout_mode = 0
offset_left = 62.0
offset_top = 274.0
offset_right = 406.0
offset_bottom = 580.0
mouse_filter = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_outline_color = Color(0.04, 0.12, 0.08, 1)
theme_override_constants/outline_size = 3
text = "Na primeira tacada de cada rodada, clique abaixo da linha branca para colocar sua bolinha.\n\nMova o mouse para mirar. Segure o botão esquerdo para carregar a força e solte para lançar.\n\nNas jogadas seguintes, continue de onde a bolinha parou."
horizontal_alignment = 0
vertical_alignment = 0
autowrap_mode = 3

