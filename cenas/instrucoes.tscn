[node name="Texto2" type="Label" parent="."]
layout_mode = 0
offset_left = 874.0
offset_top = 274.0
offset_right = 1218.0
offset_bottom = 580.0
mouse_filter = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_outline_color = Color(0.04, 0.12, 0.08, 1)
theme_override_constants/outline_size = 3
text = "Alvos comuns: 1 ponto.\nEspeciais: 2 pontos.\nBolinha central: 3 pontos.\n\nO alvo precisa sair completamente do círculo. A pontuação é apurada quando as bolinhas param.\n\nSão duas rodadas e um placar acumulado. Vence quem somar mais pontos; totais iguais dão empate."
horizontal_alignment = 0
vertical_alignment = 0
autowrap_mode = 3

[node name="Nota" type="Label" parent="."]
layout_mode = 0
offset_left = 140.0
offset_top = 602.0
offset_right = 1140.0
offset_bottom = 650.0
mouse_filter = 2
theme_override_font_sizes/font_size = 16
theme_override_colors/font_outline_color = Color(0.04, 0.12, 0.08, 1)
theme_override_constants/outline_size = 3
text = "Penalidade: centro da bolinha sobre ou dentro da borda.\nTreino: entre na conta antes de jogar; o resultado é salvo ao concluir as duas rodadas."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

